# Copy this file to .env and fill in your values. .env is ignored by git.
# Account identifier: in Snowsight, bottom-left menu > your account > "Copy account identifier"
# (looks like ORGNAME-ACCOUNTNAME). Use a dash, not a dot.
SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME
SNOWFLAKE_USER=CT_SERVICE
SNOWFLAKE_ROLE=CT_PIPELINE
SNOWFLAKE_WAREHOUSE=CT_WH
SNOWFLAKE_DATABASE=CASH_TRANSFER

# Key-pair login (made by: python ingestion/make_keypair.py)
SNOWFLAKE_PRIVATE_KEY_PATH=.secrets/snowflake_key.p8
